{
  "openapi": "3.1.0",
  "info": {
    "title": "Immunopeptidome Rule Demonstration API",
    "version": "2.0.1",
    "description": "Generic synthetic thresholds; no NetMHCpan model or clinically validated inference."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Browser console",
        "responses": {
          "200": {
            "description": "HTML console"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health and runtime metadata",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory task and audit counts (JSON)",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate demonstration task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based dossier, signed in-memory"
          },
          "422": {
            "description": "Invalid or potentially identifying input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock response",
        "responses": {
          "200": {
            "description": "Deterministic placeholder response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Audit-chain entries and signature verification",
        "responses": {
          "200": {
            "description": "In-memory entries"
          }
        }
      }
    }
  }
}
